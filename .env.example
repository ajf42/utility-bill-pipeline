# Anthropic API key for the Resolution Drafter Service.
# Required for the `@pytest.mark.integration` tests and for real
# production wiring of `src/services/drafter.py`. The default `pytest`
# run skips integration tests, so unit-test runs do not need this set.
ANTHROPIC_API_KEY=

# SQLite database path used by the FastAPI dependency `get_store()`.
# Defaults to ./prototype.db when unset.
DB_PATH=
